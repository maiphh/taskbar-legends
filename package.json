{
  "name": "taskbar-legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build:online-core",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:online-core": "tsx scripts/build-online-core.ts",
    "check:online-core": "tsx scripts/build-online-core.ts --check",
    "benchmark:online": "npm run build:online-core && node scripts/online-benchmark.mjs",
    "test:online": "npm run build:online-core && supabase test db && npm run test:online:integration",
    "test:online:integration": "node --env-file=.env.local --import tsx scripts/online-integration.ts",
    "test:online:ui": "node --env-file=.env.local scripts/online-ui-check.mjs",
    "supabase:serve": "supabase functions serve game-api --no-verify-jwt --env-file .env.local",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "measure:aac": "tsx scripts/measure-aac-offset.ts",
    "sim:v14": "tsx scripts/v14-targets.ts",
    "sim:v14:off": "tsx scripts/v14-targets.ts --rules none",
    "shot:lock": "tsx scripts/shot-lock.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tauri-apps/api": "^2.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "license": "UNLICENSED"
}
